<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BepInEx nằm trong Tool-DTD\runtime. -->
    <RuntimeDir Condition="'$(RuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\runtime</RuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RuntimeDir)\BepInEx\core\Il2CppInterop.Common.dll" />
    <Reference Include="$(RuntimeDir)\BepInEx\core\Iced.dll" />
  </ItemGroup>
</Project>
